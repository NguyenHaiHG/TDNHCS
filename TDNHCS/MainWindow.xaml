<Window x:Class="TDNHCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TDNHCS"
        xmlns:views="clr-namespace:TDNHCS.Views"
        mc:Ignorable="d"
        Title="Phần mềm tiện ích tổng hợp" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icon.ico">
    <Window.Resources>
        <Style x:Key="PlaceholderTextBox" TargetType="TextBox">

            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border
                    CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">

                            <Grid>

                                <!-- TEXT NHẬP -->
                                <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="10,0"
                            VerticalAlignment="Center"/>

                                <!-- PLACEHOLDER -->
                                <TextBlock
                            x:Name="Watermark"
                            Text="{TemplateBinding Tag}"
                            Foreground="Gray"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- KHI CÓ TEXT -> ẨN PLACEHOLDER -->
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark"
                                Property="Visibility"
                                Value="Visible"/>
                            </Trigger>

                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="Watermark"
                                Property="Visibility"
                                Value="Visible"/>
                            </Trigger>

                            <!-- KHI FOCUS -> ẨN -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Watermark"
                                Property="Visibility"
                                Value="Collapsed"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedComboBox" TargetType="ComboBox">

            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Border
                    CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">

                            <Grid>

                                <ToggleButton
                            Name="ToggleButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">

                                    <Grid>

                                        <ContentPresenter
                                        Margin="10,0,30,0"
                                         VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Content="{TemplateBinding SelectionBoxItem}"/>

                                        <TextBlock
                                    Text="▼"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"/>

                                    </Grid>

                                </ToggleButton>

                                <Popup
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom">

                                    <Border
                                Background="White"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="10">

                                        <ScrollViewer>
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>

                                    </Border>

                                </Popup>

                            </Grid>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>
        <Style x:Key="RoundedTextBox" TargetType="TextBox">

            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border
                    CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">

                            <ScrollViewer x:Name="PART_ContentHost"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="RoundedButton" TargetType="Button">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <!-- Ảnh nền mờ toàn app -->
        <Image Source="Assets/banner.png"
               Stretch="UniformToFill"
               Opacity="0.18"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>
        <TabControl Background="Transparent" BorderBrush="#33000000" BorderThickness="1">
        <TabItem Header="Trang chủ">
                <Grid>
                    <Image Source="Assets/banner.png"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Grid>
        </TabItem>
    <TabItem Header="Quản lý văn bản">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tiêu đề -->
                    <TextBlock Grid.Row="0" 
                   Text="HỆ THỐNG QUẢN LÝ VĂN BẢN"
                   FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"
                   Foreground="#2C3E50"/>

                    <!-- Nút chức năng -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Button Content="➕ Thêm"
                                    Command="{Binding AddDocumentCommand}"
                                    Padding="15,8"
                                    Margin="0,0,5,5"
                                    Background="#27AE60"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand" Style="{StaticResource RoundedButton}"
                                    Width="85"/>

                            <Button Content="✏️ Sửa"
                                    Command="{Binding EditDocumentCommand}"
                                    Padding="15,8"
                                    Margin="0,0,5,5"
                                    Background="#F39C12"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand" Style="{StaticResource RoundedButton}"
                                    Width="85"/>

                            <Button Content="🗑️ Xóa"
                                    Command="{Binding DeleteDocumentCommand}"
                                    Padding="15,8"
                                    Margin="0,0,0,5"
                                    Background="#E74C3C"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand" Style="{StaticResource RoundedButton}"
                                    Width="85"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button Content="📊 Thống kê"
                        Command="{Binding ShowStatisticsCommand}"
                        Padding="15,8"
                        Margin="0,0,5,0"
                        Background="#9B59B6"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand" Style="{StaticResource RoundedButton}"
                                Width="85" Height="30"/>

                            <Button Content="📤 Xuất Excel"
                        Command="{Binding ExportExcelCommand}"
                        Padding="15,8"
                        Margin="0,0,5,0"
                        Background="#16A085"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand" Style="{StaticResource RoundedButton}"/>

                            <Button Content="🖨️ In"
                        Command="{Binding PrintCommand}"
                        Padding="15,8"
                        Background="#34495E"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand" Style="{StaticResource RoundedButton}"/>

                            <Button Content="⚙️ Xem"
                        Command="{Binding ViewDocumentCommand}"
                        Padding="15,8"
                        Margin="5,0,0,0"
                        Background="#7F8C8D"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand" Style="{StaticResource RoundedButton}"/>

                            <Button Content="🔑 Đổi đăng nhập"
                        Command="{Binding ChangePasswordCommand}"
                        Padding="15,8"
                        Margin="5,0,0,0"
                        Background="#E67E22"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand" Style="{StaticResource RoundedButton}"/>

                            <Button Content="🔄 Cập nhật"
                        Command="{Binding CheckForUpdatesCommand}"
                        Padding="15,8"
                        Margin="5,0,0,0"
                        Background="#1ABC9C"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand" Style="{StaticResource RoundedButton}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,5">
                            <Button Content="💾 Sao lưu"
                                    Command="{Binding BackupDataCommand}"
                                    Padding="15,8"
                                    Margin="0,0,5,0"
                                    Background="#2980B9"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand" Style="{StaticResource RoundedButton}"/>

                            <Button Content="📥 Khôi phục"
                                    Command="{Binding RestoreDataCommand}"
                                    Padding="15,8"
                                    Background="#8E44AD"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand" Style="{StaticResource RoundedButton}"/>
                        </StackPanel>
                    </Grid>

                    <!-- DataGrid hiển thị danh sách văn bản -->
                    <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Documents}"
                  SelectedItem="{Binding SelectedDocument}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  AlternatingRowBackground="#F8F9FA"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  FontSize="13">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Số VB" 
                                    Binding="{Binding DocumentNumber}" 
                                    Width="120"/>

                            <DataGridTextColumn Header="Tiêu đề" 
                                    Binding="{Binding Title}" 
                                    Width="*"/>

                            <DataGridTextColumn Header="Loại VB" 
                                    Binding="{Binding Type}" 
                                    Width="100"/>

                            <DataGridTextColumn Header="Danh mục" 
                                    Binding="{Binding Category.Name}" 
                                    Width="120"/>

                            <DataGridTextColumn Header="Ngày ban hành" 
                                    Binding="{Binding IssueDate, StringFormat=dd/MM/yyyy}" 
                                    Width="110"/>

                            <DataGridTextColumn Header="Ngày nhận" 
                                    Binding="{Binding ReceivedDate, StringFormat=dd/MM/yyyy}" 
                                    Width="110"/>

                            <DataGridTextColumn Header="Người tạo" 
                                    Binding="{Binding CreatedBy}" 
                                    Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Thanh trạng thái -->
                    <StatusBar Grid.Row="3" Margin="0,10,0,0">
                        <StatusBarItem>
                            <TextBlock>
                    <Run Text="Tổng số văn bản: "/>
                    <Run Text="{Binding Documents.Count, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem>
                            <TextBlock Text="{Binding SelectedDocument.Title, StringFormat='Đang chọn: {0}'}" 
                           FontStyle="Italic"/>
                        </StatusBarItem>
                    </StatusBar>

                    <!-- Loading Overlay -->
                </Grid>
            </TabItem>

            <TabItem Header="So sánh văn bản">
                <views:DocumentCompareView x:Name="DocumentCompareView"/>
            </TabItem>
            
            <TabItem Header="Tạo hồ sơ GQVL">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Label>
                        <Label Content="Thông tin khách hàng:"/>
                    </Label>
                </ScrollViewer> 
            </TabItem>
            
            <TabItem Header="Tạo hồ sơ NOXH">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            
            <TabItem Header="Tạo hồ sơ XKLĐ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Giới thiệu">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#EAF6FF"
                                CornerRadius="18"
                                Padding="24"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="GIỚI THIỆU HỆ THỐNG"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#2C3E50"/>
                                <TextBlock Text="Hệ thống các tiện ích hỗ trợ cán bộ"
                                           FontSize="16"
                                           Foreground="#566573"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="Tác giả: Nguyễn Hải"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#2471A3"
                                           Margin="0,18,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    CornerRadius="14"
                                    BorderBrush="#D6EAF8"
                                    BorderThickness="1"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Nền tảng chương trình"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#2C3E50"
                                               Margin="0,0,0,12"/>
                                    <TextBlock Text="Ứng dụng desktop Windows phục vụ quản lý văn bản: thêm, sửa, xóa, tìm kiếm qua chatbot theo tiêu đề và nội dung, xem file đính kèm, thống kê, in và xuất Excel."
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               Foreground="#566573"/>
                                    <TextBlock Text="Dữ liệu được lưu cục bộ trên ổ D. Dùng Sao lưu để xuất file ZIP mang sang máy khác, sau đó cài app và dùng Khôi phục."
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               Foreground="#566573"
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="White"
                                    CornerRadius="14"
                                    BorderBrush="#F5B7D8"
                                    BorderThickness="1"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Stack kỹ thuật"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#2C3E50"
                                               Margin="0,0,0,12"/>
                                    <TextBlock Text="• C# / .NET 10 Windows"
                                               FontSize="14"
                                               Foreground="#566573"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="• WPF cho giao diện desktop"
                                               FontSize="14"
                                               Foreground="#566573"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="• Entity Framework Core + SQLite"
                                               FontSize="14"
                                               Foreground="#566573"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="• CommunityToolkit.Mvvm theo mô hình MVVM"
                                               FontSize="14"
                                               Foreground="#566573"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="• ClosedXML để xuất Excel"
                                               FontSize="14"
                                               Foreground="#566573"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="• Tesseract OCR tiếng Việt/Anh chạy ngoại tuyến"
                                               FontSize="14"
                                               Foreground="#566573"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="• Cập nhật tự động qua mạng"
                                               FontSize="14"
                                               Foreground="#566573"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="• Inno Setup để đóng gói bộ cài"
                                               FontSize="14"
                                               Foreground="#566573"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="#FFF8E7"
                                CornerRadius="14"
                                BorderBrush="#F9E79F"
                                BorderThickness="1"
                                Padding="18"
                                Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Thư mục chương trình: D:\QLVB  |  Dữ liệu: D:\SysCache_QLVB (tự tạo khi thêm văn bản hoặc dữ liệu đầu tiên)"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Foreground="#7D6608"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding AppVersion, StringFormat=Phiên bản hiện tại: {0}}"
                                           FontSize="14"
                                           Foreground="#7D6608"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Chatbot nổi: robot AI -->
        <Grid Grid.RowSpan="4"
              Panel.ZIndex="20"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,16,45">

            <Button Command="{Binding ToggleChatbotCommand}"
                    Width="108"
                    Height="118"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChatbotExpanded}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Ellipse Width="104" Height="104"
                             Fill="#D6EEFF" Opacity="0.55"
                             VerticalAlignment="Bottom"/>
                    <views:ChatbotRobotAvatar Width="100" Height="118"
                                              VerticalAlignment="Bottom"/>
                    <Border Background="White"
                            CornerRadius="14"
                            Padding="8,5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,-4,0,0"
                            BorderBrush="#B8D9F0"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#3498DB" BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                        </Border.Effect>
                        <TextBlock Text="Tìm văn bản?"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#2471A3"/>
                    </Border>
                </Grid>
            </Button>

            <Border Width="430"
                    MaxHeight="560"
                    CornerRadius="22"
                    Background="#F4FAFF"
                    BorderBrush="#B8D9F0"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChatbotExpanded}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect Color="#34495E" BlurRadius="28" ShadowDepth="4" Opacity="0.25"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            CornerRadius="22,22,0,0"
                            Padding="16"
                            Background="#E8F4FC">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <views:ChatbotRobotAvatar Width="84" Height="98"
                                                      Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Trợ lý AI văn bản"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#1A5276"/>
                                <Border Background="White"
                                        CornerRadius="14"
                                        Padding="10"
                                        Margin="0,6,0,0"
                                        BorderBrush="#D6EAF8"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding ChatbotMessage}"
                                               TextWrapping="Wrap"
                                               Foreground="#566573"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="Thu nhỏ"
                                    Command="{Binding ToggleChatbotCommand}"
                                    Padding="10,6"
                                    Margin="8,0,0,0"
                                    Background="#D6EAF8"
                                    Foreground="#1A5276"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="300"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="14">
                        <ItemsControl ItemsSource="{Binding ChatbotResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenChatbotDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="#F8FBFF"
                                            BorderBrush="#D6EAF8"
                                            BorderThickness="1"
                                            Padding="12"
                                            Margin="0,0,0,10"
                                            HorizontalContentAlignment="Stretch"
                                            Cursor="Hand">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       Foreground="#2C3E50"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding DocumentNumber, StringFormat='Số văn bản: {0}'}"
                                                       Foreground="#5D6D7E"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Summary}"
                                                       Foreground="#566573"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="42"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding FileLocationDisplay}"
                                                       Foreground="#2471A3"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="14">
                        <TextBlock Text="Bạn muốn tôi tìm văn bản nào?"
                                   Foreground="#34495E"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ChatbotSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10"
                                 FontSize="14"
                                 ToolTip="Nhập tiêu đề hoặc nội dung văn bản">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ChatbotSearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="Tìm văn bản"
                                Command="{Binding ChatbotSearchCommand}"
                                Margin="0,10,0,0"
                                Padding="12,9"
                                Background="#3498DB"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
