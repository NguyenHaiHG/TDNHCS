<Window x:Class="TDNHCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TDNHCS"
        mc:Ignorable="d"
        Title="Hệ thống Quản lý Văn bản" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PlaceholderTextBox" TargetType="TextBox">

            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border
                    CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">

                            <Grid>

                                <!-- TEXT NHẬP -->
                                <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="10,0"
                            VerticalAlignment="Center"/>

                                <!-- PLACEHOLDER -->
                                <TextBlock
                            x:Name="Watermark"
                            Text="{TemplateBinding Tag}"
                            Foreground="Gray"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- KHI CÓ TEXT -> ẨN PLACEHOLDER -->
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark"
                                Property="Visibility"
                                Value="Visible"/>
                            </Trigger>

                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="Watermark"
                                Property="Visibility"
                                Value="Visible"/>
                            </Trigger>

                            <!-- KHI FOCUS -> ẨN -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Watermark"
                                Property="Visibility"
                                Value="Collapsed"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedComboBox" TargetType="ComboBox">

            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Border
                    CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">

                            <Grid>

                                <ToggleButton
                            Name="ToggleButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">

                                    <Grid>

                                        <ContentPresenter
                                        Margin="10,0,30,0"
                                         VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Content="{TemplateBinding SelectionBoxItem}"/>          

                                        <TextBlock
                                    Text="▼"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"/>

                                    </Grid>

                                </ToggleButton>

                                <Popup
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom">

                                    <Border
                                Background="White"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="10">

                                        <ScrollViewer>
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>

                                    </Border>

                                </Popup>

                            </Grid>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>    
        <Style x:Key="RoundedTextBox" TargetType="TextBox">

            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border
                    CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">

                            <ScrollViewer x:Name="PART_ContentHost"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="RoundedButton" TargetType="Button">
  
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <TabControl>
            <TabItem Header="Quản lý văn bản">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tiêu đề -->
                    <TextBlock Grid.Row="0" 
                   Text="HỆ THỐNG QUẢN LÝ VĂN BẢN"
                   FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"
                   Foreground="#2C3E50"/>

                    <!-- Thanh tìm kiếm và nút chức năng -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Dòng 1: Tìm kiếm và CRUD -->
                        <TextBox Grid.Row="0" Grid.Column="0" 
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14"
                     Padding="8"
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,5">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Row="0" Grid.Column="1" 
                    Content="🔍 Tìm kiếm"
                    Command="{Binding SearchCommand}"
                    Padding="15,8"
                    Margin="0,0,5,5"
                    Background="#3498DB"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>

                        <Button Grid.Row="0" Grid.Column="2" 
                    Content="➕ Thêm"
                    Command="{Binding AddDocumentCommand}"
                    Padding="15,8"
                    Margin="0,0,5,5"
                    Background="#27AE60"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>

                        <Button Grid.Row="0" Grid.Column="3" 
                    Content="✏️ Sửa"
                    Command="{Binding EditDocumentCommand}"
                    Padding="15,8"
                    Margin="0,0,5,5"
                    Background="#F39C12"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>

                        <Button Grid.Row="0" Grid.Column="4" 
                    Content="🗑️ Xóa"
                    Command="{Binding DeleteDocumentCommand}"
                    Padding="15,8"
                    Margin="0,0,0,5"
                    Background="#E74C3C"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
                        <!-- Dòng 2: Chức năng mở rộng -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right">

                            <Button Content="📊 Thống kê"
                        Command="{Binding ShowStatisticsCommand}"
                        Padding="15,8"
                        Margin="0,0,5,0"
                        Background="#9B59B6"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

                            <Button Content="📤 Xuất Excel"
                        Command="{Binding ExportExcelCommand}"
                        Padding="15,8"
                        Margin="0,0,5,0"
                        Background="#16A085"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

                            <Button Content="🖨️ In"
                        Command="{Binding PrintCommand}"
                        Padding="15,8"
                        Background="#34495E"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

                            <Button Content="⚙️ Xem"
                        Command="{Binding ViewDocumentCommand}"
                        Padding="15,8"
                        Margin="5,0,0,0"
                        Background="#7F8C8D"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

                            <Button Content="🔑 Đổi mật khẩu"
                        Command="{Binding ChangePasswordCommand}"
                        Padding="15,8"
                        Margin="5,0,0,0"
                        Background="#E67E22"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

                            <Button Content="🔄 Cập nhật"
                        Command="{Binding CheckForUpdatesCommand}"
                        Padding="15,8"
                        Margin="5,0,0,0"
                        Background="#1ABC9C"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- DataGrid hiển thị danh sách văn bản -->
                    <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Documents}"
                  SelectedItem="{Binding SelectedDocument}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  AlternatingRowBackground="#F8F9FA"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  FontSize="13">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Số VB" 
                                    Binding="{Binding DocumentNumber}" 
                                    Width="120"/>

                            <DataGridTextColumn Header="Tiêu đề" 
                                    Binding="{Binding Title}" 
                                    Width="*"/>

                            <DataGridTextColumn Header="Loại VB" 
                                    Binding="{Binding Type}" 
                                    Width="100"/>

                            <DataGridTextColumn Header="Danh mục" 
                                    Binding="{Binding Category.Name}" 
                                    Width="120"/>

                            <DataGridTextColumn Header="Ngày ban hành" 
                                    Binding="{Binding IssueDate, StringFormat=dd/MM/yyyy}" 
                                    Width="110"/>

                            <DataGridTextColumn Header="Ngày nhận" 
                                    Binding="{Binding ReceivedDate, StringFormat=dd/MM/yyyy}" 
                                    Width="110"/>

                            <DataGridTextColumn Header="Người tạo" 
                                    Binding="{Binding CreatedBy}" 
                                    Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Thanh trạng thái -->
                    <StatusBar Grid.Row="3" Margin="0,10,0,0">
                        <StatusBarItem>
                            <TextBlock>
                    <Run Text="Tổng số văn bản: "/>
                    <Run Text="{Binding Documents.Count, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem>
                            <TextBlock Text="{Binding SelectedDocument.Title, StringFormat='Đang chọn: {0}'}" 
                           FontStyle="Italic"/>
                        </StatusBarItem>
                    </StatusBar>

                    <!-- Loading Overlay -->
                    <Grid Grid.RowSpan="4" 
              Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⏳ Đang tải dữ liệu..." 
                           FontSize="20" 
                           Foreground="White" 
                           FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Giới thiệu">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#EAF6FF"
                                CornerRadius="18"
                                Padding="24"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="GIỚI THIỆU HỆ THỐNG"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#2C3E50"/>
                                <TextBlock Text="Hệ thống quản lý văn bản nội bộ"
                                           FontSize="16"
                                           Foreground="#566573"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="Tác giả: Nguyễn Hải"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#2471A3"
                                           Margin="0,18,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    CornerRadius="14"
                                    BorderBrush="#D6EAF8"
                                    BorderThickness="1"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Nền tảng chương trình"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#2C3E50"
                                               Margin="0,0,0,12"/>
                                    <TextBlock Text="Ứng dụng desktop Windows phục vụ quản lý văn bản: thêm, sửa, xóa, tìm kiếm theo tiêu đề và nội dung, xem file đính kèm, thống kê, in và xuất Excel."
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               Foreground="#566573"/>
                                    <TextBlock Text="Dữ liệu được lưu cục bộ trên ổ D để dễ triển khai trong môi trường nội bộ."
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               Foreground="#566573"
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="White"
                                    CornerRadius="14"
                                    BorderBrush="#F5B7D8"
                                    BorderThickness="1"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Stack kỹ thuật"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#2C3E50"
                                               Margin="0,0,0,12"/>
                                    <TextBlock Text="• C# / .NET 10 Windows"
                                               FontSize="14"
                                               Foreground="#566573"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="• WPF cho giao diện desktop"
                                               FontSize="14"
                                               Foreground="#566573"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="• Entity Framework Core + SQLite"
                                               FontSize="14"
                                               Foreground="#566573"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="• CommunityToolkit.Mvvm theo mô hình MVVM"
                                               FontSize="14"
                                               Foreground="#566573"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="• ClosedXML để xuất Excel"
                                               FontSize="14"
                                               Foreground="#566573"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="• GitHub Releases để cập nhật từ xa"
                                               FontSize="14"
                                               Foreground="#566573"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="• Inno Setup để đóng gói bộ cài"
                                               FontSize="14"
                                               Foreground="#566573"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="#FFF8E7"
                                CornerRadius="14"
                                BorderBrush="#F9E79F"
                                BorderThickness="1"
                                Padding="18"
                                Margin="0,18,0,0">
                            <TextBlock Text="Thư mục chương trình: D:\QLVB  |  Database: D:\SysCache_QLVB\data.db  |  File đính kèm: D:\SysCache_QLVB\store"
                                       TextWrapping="Wrap"
                                       FontSize="14"
                                       Foreground="#7D6608"/>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem HorizontalAlignment="Center" Height="20" Header="Hợp đồng GQVL" VerticalAlignment="Top" Width="120" Margin="0,-1,0,0">
                <Grid Background="#FFE5E5E5">
                    <Border CornerRadius="10"
        BorderBrush="#CCCCCC"
        BorderThickness="1"
        Margin="20,320,20,20"
        Padding="5">

                        <DataGrid
        AutoGenerateColumns="False"
        RowHeight="35"
        FontSize="14"
        GridLinesVisibility="Horizontal"
        HeadersVisibility="Column"
        Background="White"
        BorderThickness="0">

                            <DataGrid.Columns>

                                <DataGridCheckBoxColumn
                            Header="Chọn"
                            Width="60"
                            Binding="{Binding isSelected}"/>

                                <DataGridTextColumn
                Header="Tên khách hàng"
                Width="200"
                Binding="{Binding TenKhachHang}"/>

                                <DataGridTextColumn
                Header="Số hợp đồng"
                Width="200"
                Binding="{Binding SoHopDong}"/>

                                <DataGridTextColumn
                Header="Số Căn cước"
                Width="150"
                Binding="{Binding SoCanCuoc}"/>

                                <DataGridTextColumn
                Header="Số tiền vay"
                Width="150"
                Binding="{Binding SoTienVay}"/>

                                <DataGridTextColumn
                Header="Số điện thoại"
                Width="150"
                Binding="{Binding SoDienThoai}"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>
                    <TextBox HorizontalAlignment="Left" Margin="97,65,0,0" TextWrapping="Wrap" Tag="Số hợp đồng" VerticalAlignment="Top" Width="120" Style="{StaticResource RoundedTextBox}"/>
                    <ComboBox IsEditable="True" HorizontalAlignment="Left" Margin="95,101,0,0" VerticalAlignment="Top" Width="120" Style="{StaticResource RoundedComboBox}">
                        <ComboBoxItem Content="10.000.000"/>
                        <ComboBoxItem Content="20.000.000"/>
                        <ComboBoxItem Content="50.000.000"/>
                        <ComboBoxItem Content="100.000.000"/>
                        <ComboBoxItem Content="200.000.000"/>
                    </ComboBox>
                    <Label Content="Số tiền vay:" HorizontalAlignment="Left" Margin="10,98,0,0" VerticalAlignment="Top"/>
                    <TextBox HorizontalAlignment="Left" Margin="94,129,0,0" TextWrapping="Wrap" Tag="Số điện thoại" VerticalAlignment="Top" Width="120" Style="{StaticResource RoundedTextBox}"/>
                    <Button Content="Tạo hợp đồng" Width="120" Height="20" HorizontalAlignment="Left" Margin="82,263,0,0" VerticalAlignment="Top" Style="{StaticResource RoundedButton}" Background ="Green"/>
                    <Button Content="Xoá hợp đồng" Width="120" Height="20" HorizontalAlignment="Left" Margin="82,294,0,0" VerticalAlignment="Top" Style="{StaticResource RoundedButton}" Background ="Red"/>
                    <Button Content="Lấy file excel mẫu" Width="120" Height="20" HorizontalAlignment="Left" Margin="232,262,0,0" VerticalAlignment="Top" Style="{StaticResource RoundedButton}" Background = "Aqua" Foreground="Black"/>
                    <Button Content="Upload file excel mẫu" Width="120" Height="20" HorizontalAlignment="Left" Margin="232,292,0,0" VerticalAlignment="Top" Style="{StaticResource RoundedButton}" Background = "Chartreuse" Foreground="Black"/>

                </Grid>
            </TabItem>
        </TabControl>

        <!-- Chatbot nổi: thu gọn thành bong bóng, click để mở hội thoại -->
        <Grid Grid.RowSpan="4"
              Panel.ZIndex="20"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,0,45">

            <Button Command="{Binding ToggleChatbotCommand}"
                    Width="96"
                    Height="96"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChatbotExpanded}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Polygon Points="24,28 34,3 47,30"
                             Fill="#FDE2F3"
                             Stroke="#F48AC7"
                             StrokeThickness="2"/>
                    <Polygon Points="49,30 62,3 72,28"
                             Fill="#FDE2F3"
                             Stroke="#F48AC7"
                             StrokeThickness="2"/>
                    <Border Width="82"
                            Height="68"
                            CornerRadius="26"
                            Background="#EAF8FF"
                            BorderBrush="#77C9F2"
                            BorderThickness="2"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#8E44AD" BlurRadius="22" ShadowDepth="4" Opacity="0.35"/>
                        </Border.Effect>
                    </Border>
                    <Ellipse Width="17" Height="19" Fill="#2C3E50" Margin="24,35,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Ellipse Width="17" Height="19" Fill="#2C3E50" Margin="0,35,24,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <Ellipse Width="7" Height="7" Fill="White" Margin="30,39,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Ellipse Width="7" Height="7" Fill="White" Margin="0,39,30,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <Path Data="M 38 57 Q 48 66 58 57"
                          Stroke="#FF7DBF"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Fill="Transparent"/>
                    <Ellipse Width="10" Height="8" Fill="#FFB3D9" Margin="16,53,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Ellipse Width="10" Height="8" Fill="#FFB3D9" Margin="0,53,16,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <Line X1="48" Y1="7" X2="48" Y2="17" Stroke="#77C9F2" StrokeThickness="3"/>
                    <Ellipse Width="12" Height="12" Fill="#FFD166" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0"/>
                    <Border Background="#EAF6FF"
                            CornerRadius="12"
                            Padding="8,4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,-8,0,0">
                        <TextBlock Text="Tìm văn bản?" FontSize="12" FontWeight="SemiBold" Foreground="#2C3E50"/>
                    </Border>
                </Grid>
            </Button>

            <Border Width="430"
                    MaxHeight="560"
                    CornerRadius="26"
                    Background="White"
                    BorderBrush="#F5B7D8"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChatbotExpanded}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect Color="#34495E" BlurRadius="28" ShadowDepth="4" Opacity="0.25"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            CornerRadius="26,26,0,0"
                            Padding="16"
                            Background="#FFF0F8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="76" Height="76" Margin="0,0,12,0">
                                <Polygon Points="18,29 29,4 42,31"
                                         Fill="#FDE2F3"
                                         Stroke="#F48AC7"
                                         StrokeThickness="2"/>
                                <Polygon Points="36,31 49,4 60,29"
                                         Fill="#FDE2F3"
                                         Stroke="#F48AC7"
                                         StrokeThickness="2"/>
                                <Border Width="68"
                                        Height="58"
                                        CornerRadius="22"
                                        Background="#EAF8FF"
                                        BorderBrush="#77C9F2"
                                        BorderThickness="2"
                                        VerticalAlignment="Center"/>
                                <Ellipse Width="13" Height="15" Fill="#2C3E50" Margin="22,34,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Ellipse Width="13" Height="15" Fill="#2C3E50" Margin="0,34,22,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                <Ellipse Width="5" Height="5" Fill="White" Margin="27,37,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Ellipse Width="5" Height="5" Fill="White" Margin="0,37,27,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                <Path Data="M 31 53 Q 38 60 45 53"
                                      Stroke="#FF7DBF"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"/>
                                <Line X1="38" Y1="7" X2="38" Y2="16" Stroke="#77C9F2" StrokeThickness="3"/>
                                <Ellipse Width="11" Height="11" Fill="#FFD166" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Bé trợ lý văn bản"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#2C3E50"/>
                                <Border Background="White"
                                        CornerRadius="14"
                                        Padding="10"
                                        Margin="0,6,0,0">
                                    <TextBlock Text="{Binding ChatbotMessage}"
                                               TextWrapping="Wrap"
                                               Foreground="#566573"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="Thu nhỏ"
                                    Command="{Binding ToggleChatbotCommand}"
                                    Padding="10,6"
                                    Margin="8,0,0,0"
                                    Background="#FADBD8"
                                    Foreground="#7B241C"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="300"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="14">
                        <ItemsControl ItemsSource="{Binding ChatbotResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenChatbotDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="#F8FBFF"
                                            BorderBrush="#D6EAF8"
                                            BorderThickness="1"
                                            Padding="12"
                                            Margin="0,0,0,10"
                                            HorizontalContentAlignment="Stretch"
                                            Cursor="Hand">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       Foreground="#2C3E50"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding DocumentNumber, StringFormat='Số văn bản: {0}'}"
                                                       Foreground="#5D6D7E"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Summary}"
                                                       Foreground="#566573"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="42"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding FileLocationDisplay}"
                                                       Foreground="#2471A3"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="14">
                        <TextBlock Text="Bạn muốn tôi tìm văn bản nào?"
                                   Foreground="#34495E"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ChatbotSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10"
                                 FontSize="14"
                                 ToolTip="Nhập tiêu đề hoặc nội dung văn bản">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ChatbotSearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="Tìm văn bản"
                                Command="{Binding ChatbotSearchCommand}"
                                Margin="0,10,0,0"
                                Padding="12,9"
                                Background="#FF8CCB"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
