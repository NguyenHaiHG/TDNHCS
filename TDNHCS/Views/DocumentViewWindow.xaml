<Window x:Class="TDNHCS.Views.DocumentViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem Văn Bản" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: Thông tin văn bản -->
        <Border Grid.Column="0" Background="White" CornerRadius="6"
                BorderBrush="#DCDCDC" BorderThickness="1" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="THÔNG TIN VĂN BẢN"
                               FontSize="14" FontWeight="Bold"
                               Foreground="#2C3E50"
                               Margin="0,0,0,15"
                               HorizontalAlignment="Center"/>

                    <!-- Số VB -->
                    <TextBlock Text="Số văn bản" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,3"/>
                    <TextBlock x:Name="txtDocumentNumber" FontSize="14" Foreground="#2C3E50"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Tiêu đề -->
                    <TextBlock Text="Tiêu đề" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,3"/>
                    <TextBlock x:Name="txtTitle" FontSize="14" Foreground="#2C3E50"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Loại VB -->
                    <TextBlock Text="Loại văn bản" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,3"/>
                    <TextBlock x:Name="txtType" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,12"/>

                    <!-- Danh mục -->
                    <TextBlock Text="Danh mục" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,3"/>
                    <TextBlock x:Name="txtCategory" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,12"/>

                    <!-- Ngày ban hành -->
                    <TextBlock Text="Ngày ban hành" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,3"/>
                    <TextBlock x:Name="txtIssueDate" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,12"/>

                    <!-- Ngày nhận -->
                    <TextBlock Text="Ngày nhận" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,3"/>
                    <TextBlock x:Name="txtReceivedDate" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,12"/>

                    <!-- Người tạo -->
                    <TextBlock Text="Người tạo" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,3"/>
                    <TextBlock x:Name="txtCreatedBy" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,12"/>

                    <!-- Tóm tắt -->
                    <TextBlock Text="Tóm tắt nội dung" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,3"/>
                    <TextBlock x:Name="txtSummary" FontSize="13" Foreground="#2C3E50"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Ghi chú -->
                    <TextBlock Text="Ghi chú" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,3"/>
                    <TextBlock x:Name="txtNotes" FontSize="13" Foreground="#2C3E50"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- File đính kèm -->
                    <TextBlock Text="File đính kèm" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,3"/>
                    <TextBlock x:Name="txtFilePath" FontSize="12" Foreground="#3498DB"
                               TextWrapping="Wrap" Margin="0,0,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- CỘT PHẢI: Preview nội dung file -->
        <Border Grid.Column="2" Background="White" CornerRadius="6"
                BorderBrush="#DCDCDC" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header preview -->
                <Border Grid.Row="0" Background="#2C3E50" CornerRadius="6,6,0,0" Padding="15,10">
                    <TextBlock x:Name="txtPreviewHeader"
                               Text="XEM NỘI DUNG FILE"
                               FontWeight="Bold" Foreground="White" FontSize="13"/>
                </Border>

                <!-- Vùng preview -->
                <Grid Grid.Row="1">
                    <!-- WebBrowser cho PDF -->
                    <WebBrowser x:Name="webBrowser" Visibility="Collapsed"/>

                    <!-- TextBox cho file text -->
                    <TextBox x:Name="txtFileContent"
                             Visibility="Collapsed"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="13"
                             Padding="12"
                             BorderThickness="0"/>

                    <!-- Placeholder cho file không hỗ trợ preview -->
                    <StackPanel x:Name="pnlNoPreview"
                                Visibility="Collapsed"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="📄" FontSize="60" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtNoPreviewMsg"
                                   FontSize="15" Foreground="#7F8C8D"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="20,10,20,0"/>
                    </StackPanel>

                    <!-- Placeholder khi không có file -->
                    <StackPanel x:Name="pnlNoFile"
                                Visibility="Visible"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="📂" FontSize="60" HorizontalAlignment="Center"/>
                        <TextBlock Text="Văn bản này chưa có file đính kèm"
                                   FontSize="15" Foreground="#BDC3C7"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
