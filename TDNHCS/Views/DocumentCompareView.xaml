<UserControl x:Class="TDNHCS.Views.DocumentCompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:TDNHCS.Models"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="950">
    <UserControl.Resources>
        <Style x:Key="CompareButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
        <Style x:Key="WrappedCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="SO SÁNH VĂN BẢN BẰNG DIFF VÀ TF-IDF"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="#2C3E50"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Văn bản thứ nhất" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Documents}"
                                  SelectedItem="{Binding SelectedLeftDocument}"
                                  DisplayMemberPath="Title"
                                  ToolTip="Chọn văn bản đã lưu"/>
                        <Button Grid.Column="1"
                                Content="Mở file"
                                Command="{Binding BrowseLeftCommand}"
                                Background="#2980B9"
                                Style="{StaticResource CompareButton}"/>
                    </Grid>
                    <TextBox Grid.Row="1"
                             Text="{Binding LeftText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="6"
                             ToolTip="Có thể nhập hoặc dán trực tiếp nội dung"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Văn bản thứ hai" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Documents}"
                                  SelectedItem="{Binding SelectedRightDocument}"
                                  DisplayMemberPath="Title"
                                  ToolTip="Chọn văn bản đã lưu"/>
                        <Button Grid.Column="1"
                                Content="Mở file"
                                Command="{Binding BrowseRightCommand}"
                                Background="#2980B9"
                                Style="{StaticResource CompareButton}"/>
                    </Grid>
                    <TextBox Grid.Row="1"
                             Text="{Binding RightText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="6"
                             ToolTip="Có thể nhập hoặc dán trực tiếp nội dung"/>
                </Grid>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="So sánh"
                        Command="{Binding CompareCommand}"
                        Background="#27AE60"
                        Style="{StaticResource CompareButton}"
                        Margin="0"/>
                <Button Content="Làm mới"
                        Command="{Binding ClearCommand}"
                        Background="#7F8C8D"
                        Style="{StaticResource CompareButton}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{Binding SimilarityDisplay}"
                           FontWeight="Bold"
                           FontSize="15"
                           Foreground="#2471A3"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SummaryDisplay}"
                           Margin="18,0,0,0"
                           Foreground="#566573"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#E8F8F5" Padding="6,3" Margin="4,0"><TextBlock Text="Xanh: thêm"/></Border>
                <Border Background="#FDEDEC" Padding="6,3" Margin="4,0"><TextBlock Text="Đỏ: xóa"/></Border>
                <Border Background="#FCF3CF" Padding="6,3" Margin="4,0"><TextBlock Text="Vàng: thay đổi"/></Border>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding DiffRows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  AlternatingRowBackground="#F8F9FA"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  SelectionMode="Single">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Added}">
                            <Setter Property="Background" Value="#E8F8F5"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Removed}">
                            <Setter Property="Background" Value="#FDEDEC"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Modified}">
                            <Setter Property="Background" Value="#FCF3CF"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Loại" Binding="{Binding ChangeDisplay}" Width="85"/>
                <DataGridTextColumn Header="Dòng A" Binding="{Binding LeftLineNumber}" Width="60"/>
                <DataGridTextColumn Header="Nội dung văn bản thứ nhất"
                                    Binding="{Binding LeftText}"
                                    ElementStyle="{StaticResource WrappedCell}"
                                    Width="*"/>
                <DataGridTextColumn Header="Dòng B" Binding="{Binding RightLineNumber}" Width="60"/>
                <DataGridTextColumn Header="Nội dung văn bản thứ hai"
                                    Binding="{Binding RightText}"
                                    ElementStyle="{StaticResource WrappedCell}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
