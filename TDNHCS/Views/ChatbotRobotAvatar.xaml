<UserControl x:Class="TDNHCS.Views.ChatbotRobotAvatar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="100" d:DesignHeight="118">
    <UserControl.Resources>
        <RadialGradientBrush x:Key="EyeGlowBrush" GradientOrigin="0.35,0.35">
            <GradientStop Color="#7FE8FF" Offset="0"/>
            <GradientStop Color="#1E90FF" Offset="0.55"/>
            <GradientStop Color="#005BBB" Offset="1"/>
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#E8EEF5" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeadShellBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#EEF5FB" Offset="0.58"/>
            <GradientStop Color="#C8D8E6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FaceScreenBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1B2633" Offset="0"/>
            <GradientStop Color="#050A12" Offset="0.62"/>
            <GradientStop Color="#111D2B" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="100" Height="118">
            <!-- Đế nền xanh nhạt -->
            <Ellipse Canvas.Left="4" Canvas.Top="18" Width="92" Height="92"
                     Fill="#D6EEFF" Opacity="0.85"/>

            <!-- Đầu robot kiểu màn hình đen bóng, bỏ tai vàng -->
            <Border Canvas.Left="12" Canvas.Top="18" Width="76" Height="66"
                    CornerRadius="31"
                    Background="{StaticResource HeadShellBrush}"
                    BorderBrush="#B7C9D8"
                    BorderThickness="1.8">
                <Border.Effect>
                    <DropShadowEffect Color="#8EB6D0" BlurRadius="9" ShadowDepth="1" Opacity="0.35"/>
                </Border.Effect>
            </Border>
            <Ellipse Canvas.Left="20" Canvas.Top="22" Width="52" Height="21"
                     Fill="White" Opacity="0.32"/>

            <Border Canvas.Left="20" Canvas.Top="31" Width="60" Height="33"
                    CornerRadius="17"
                    Background="{StaticResource FaceScreenBrush}"
                    BorderBrush="#31465B"
                    BorderThickness="1.1"/>
            <Border Canvas.Left="23" Canvas.Top="33" Width="33" Height="11"
                    CornerRadius="7"
                    Background="#55FFFFFF"
                    Opacity="0.28"/>

            <!-- Mắt phát sáng như màn hình AI -->
            <Ellipse Canvas.Left="32" Canvas.Top="42" Width="12" Height="12"
                     Fill="#F8FFFF">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#86F1FF" BlurRadius="9" ShadowDepth="0" Opacity="0.9"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Canvas.Left="56" Canvas.Top="42" Width="12" Height="12"
                     Fill="#F8FFFF">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#86F1FF" BlurRadius="9" ShadowDepth="0" Opacity="0.9"/>
                </Ellipse.Effect>
            </Ellipse>
            <Line X1="43" Y1="61" X2="57" Y2="61"
                  Stroke="#57D7F7" StrokeThickness="1.3"
                  Opacity="0.45"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

            <!-- Thân -->
            <Border Canvas.Left="28" Canvas.Top="82" Width="44" Height="28"
                    CornerRadius="14" Background="{StaticResource BodyBrush}"
                    BorderBrush="#C5D3E0" BorderThickness="1.5"/>

            <!-- Huy hiệu ngực -->
            <Ellipse Canvas.Left="40" Canvas.Top="87" Width="20" Height="20"
                     Fill="#E8EEF5" Stroke="#AEB8C4" StrokeThickness="1.2"/>
            <TextBlock Canvas.Left="40" Canvas.Top="90" Width="20" Text="AI"
                       FontSize="8" FontWeight="Bold" Foreground="#2471A3"
                       TextAlignment="Center"/>

            <!-- Tay -->
            <Ellipse Canvas.Left="18" Canvas.Top="86" Width="14" Height="14"
                     Fill="White" Stroke="#C5D3E0" StrokeThickness="1.2"/>
            <Ellipse Canvas.Left="68" Canvas.Top="86" Width="14" Height="14"
                     Fill="White" Stroke="#C5D3E0" StrokeThickness="1.2"/>
        </Canvas>
    </Viewbox>
</UserControl>
