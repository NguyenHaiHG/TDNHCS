<UserControl x:Class="TDNHCS.Views.ChatbotRobotAvatar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="100" d:DesignHeight="118">
    <UserControl.Resources>
        <RadialGradientBrush x:Key="EyeGlowBrush" GradientOrigin="0.35,0.35">
            <GradientStop Color="#7FE8FF" Offset="0"/>
            <GradientStop Color="#1E90FF" Offset="0.55"/>
            <GradientStop Color="#005BBB" Offset="1"/>
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#E8EEF5" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="EarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFE566" Offset="0"/>
            <GradientStop Color="#F5C400" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="100" Height="118">
            <!-- Đế nền xanh nhạt -->
            <Ellipse Canvas.Left="4" Canvas.Top="18" Width="92" Height="92"
                     Fill="#D6EEFF" Opacity="0.85"/>

            <!-- Tai nhọn vàng kiểu mèo -->
            <Polygon Points="10,30 18,2 28,28"
                     Fill="{StaticResource EarBrush}"
                     Stroke="#E6B800" StrokeThickness="1.5"
                     StrokeLineJoin="Round"/>
            <Polygon Points="72,30 80,2 90,28"
                     Fill="{StaticResource EarBrush}"
                     Stroke="#E6B800" StrokeThickness="1.5"
                     StrokeLineJoin="Round"/>
            <Polygon Points="14,22 18,10 22,24"
                     Fill="#FFF4B0" Opacity="0.55"/>
            <Polygon Points="76,22 80,10 84,24"
                     Fill="#FFF4B0" Opacity="0.55"/>

            <!-- Đầu robot tròn trắng -->
            <Ellipse Canvas.Left="14" Canvas.Top="22" Width="72" Height="72"
                     Fill="White" Stroke="#C5D3E0" StrokeThickness="2"/>
            <Ellipse Canvas.Left="20" Canvas.Top="28" Width="60" Height="58"
                     Fill="#FAFCFF" Opacity="0.9"/>

            <!-- Mắt phát sáng xanh -->
            <Ellipse Canvas.Left="26" Canvas.Top="42" Width="22" Height="22"
                     Fill="{StaticResource EyeGlowBrush}">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#00AEEF" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Canvas.Left="52" Canvas.Top="42" Width="22" Height="22"
                     Fill="{StaticResource EyeGlowBrush}">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#00AEEF" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Lưới hex trong mắt -->
            <Path Canvas.Left="31" Canvas.Top="47"
                  Data="M0,6 L5,3 L10,6 L10,12 L5,15 L0,12 Z"
                  Stroke="#B8F0FF" StrokeThickness="0.8" Fill="#33FFFFFF"/>
            <Path Canvas.Left="57" Canvas.Top="47"
                  Data="M0,6 L5,3 L10,6 L10,12 L5,15 L0,12 Z"
                  Stroke="#B8F0FF" StrokeThickness="0.8" Fill="#33FFFFFF"/>

            <!-- Miệng -->
            <Line X1="42" Y1="72" X2="58" Y2="72"
                  Stroke="#5D6D7E" StrokeThickness="2.2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

            <!-- Thân -->
            <Border Canvas.Left="28" Canvas.Top="82" Width="44" Height="28"
                    CornerRadius="14" Background="{StaticResource BodyBrush}"
                    BorderBrush="#C5D3E0" BorderThickness="1.5"/>

            <!-- Huy hiệu ngực -->
            <Ellipse Canvas.Left="40" Canvas.Top="87" Width="20" Height="20"
                     Fill="#E8EEF5" Stroke="#AEB8C4" StrokeThickness="1.2"/>
            <TextBlock Canvas.Left="40" Canvas.Top="90" Width="20" Text="AI"
                       FontSize="8" FontWeight="Bold" Foreground="#2471A3"
                       TextAlignment="Center"/>

            <!-- Tay -->
            <Ellipse Canvas.Left="18" Canvas.Top="86" Width="14" Height="14"
                     Fill="White" Stroke="#C5D3E0" StrokeThickness="1.2"/>
            <Ellipse Canvas.Left="68" Canvas.Top="86" Width="14" Height="14"
                     Fill="White" Stroke="#C5D3E0" StrokeThickness="1.2"/>
        </Canvas>
    </Viewbox>
</UserControl>
