<Window x:Class="TDNHCS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Đăng nhập" Height="480" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="White" CornerRadius="15" BorderBrush="#3498DB" BorderThickness="2">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo và Tiêu đề -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="🔐" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="HỆ THỐNG QUẢN LÝ VĂN BẢN" 
                           FontSize="17" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#2C3E50"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,8,0,3"/>
                <TextBlock Text="Đăng nhập để tiếp tục" 
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="#7F8C8D"/>
            </StackPanel>

            <!-- Form đăng nhập -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUsername" 
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Padding="10" Margin="0,0,0,12"
                         BorderBrush="#BDC3C7" BorderThickness="1"/>

                <TextBlock Text="Mật khẩu" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" 
                             PasswordChanged="PasswordBox_PasswordChanged"
                             FontSize="14" Padding="10" Margin="0,0,0,10"
                             BorderBrush="#BDC3C7" BorderThickness="1"/>

                <TextBlock x:Name="txtError" 
                           Text="{Binding ErrorMessage}"
                           Foreground="Red" 
                           TextAlignment="Center"
                           Margin="0,5,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Nút chức năng -->
            <StackPanel Grid.Row="2">
                <Button Content="🔓 Đăng nhập"
                        Command="{Binding LoginCommand}"
                        Padding="0,12"
                        FontSize="14" FontWeight="SemiBold"
                        Background="#3498DB" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,0,0,8"/>

                <Button Content="❌ Thoát"
                        Click="CancelButton_Click"
                        Padding="0,10"
                        FontSize="12"
                        Background="Transparent" Foreground="#7F8C8D"
                        BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
