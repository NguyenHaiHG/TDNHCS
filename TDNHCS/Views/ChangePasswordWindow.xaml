<Window x:Class="TDNHCS.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi thông tin đăng nhập" Height="490" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Grid.Row="0" Text="ĐỔI THÔNG TIN ĐĂNG NHẬP"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Form -->
        <StackPanel Grid.Row="1">

            <TextBlock Text="Tên đăng nhập mới" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14" Padding="8" Margin="0,0,0,15"
                     MaxLength="100"/>

            <TextBlock Text="Mật khẩu cũ" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <PasswordBox x:Name="pbOldPassword" FontSize="14" Padding="8"
                             PasswordChanged="pbOldPassword_PasswordChanged"/>
                <TextBox x:Name="txtOldPassword" FontSize="14" Padding="8"
                         Visibility="Collapsed"
                         TextChanged="txtOldPassword_TextChanged"/>
            </Grid>

            <TextBlock Text="Mật khẩu mới" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <PasswordBox x:Name="pbNewPassword" FontSize="14" Padding="8"
                             PasswordChanged="pbNewPassword_PasswordChanged"/>
                <TextBox x:Name="txtNewPassword" FontSize="14" Padding="8"
                         Visibility="Collapsed"
                         TextChanged="txtNewPassword_TextChanged"/>
            </Grid>

            <TextBlock Text="Xác nhận mật khẩu mới" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,8">
                <PasswordBox x:Name="pbConfirmPassword" FontSize="14" Padding="8"
                             PasswordChanged="pbConfirmPassword_PasswordChanged"/>
                <TextBox x:Name="txtConfirmPassword" FontSize="14" Padding="8"
                         Visibility="Collapsed"
                         TextChanged="txtConfirmPassword_TextChanged"/>
            </Grid>

            <CheckBox Content="Hiện mật khẩu"
                      Checked="ShowPasswords_Changed"
                      Unchecked="ShowPasswords_Changed"
                      Margin="0,0,0,8"
                      Cursor="Hand"/>

            <!-- Thông báo lỗi -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#E74C3C" FontSize="13"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Nút bấm -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="✔ Lưu thay đổi"
                    Command="{Binding ChangePasswordCommand}"
                    Padding="10,10"
                    Background="#27AE60" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    FontSize="14"/>

            <Button Grid.Column="2" Content="✖ Hủy"
                    Command="{Binding CancelCommand}"
                    Padding="10,10"
                    Background="#95A5A6" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    FontSize="14"/>
        </Grid>
    </Grid>
</Window>
